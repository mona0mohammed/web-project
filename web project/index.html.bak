<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Violetta Café</title>

    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/bootstrap.min.css">
    <link rel="stylesheet" href="css/all.min.css">
</head>

<body>

    <!-- Header -->
    <header>

        <div class="logo">
            <i class="fa-solid fa-mug-hot"></i> Violetta Café
        </div>

        <nav>
            <a href="index.html"><i class="fa-solid fa-home"></i> Home</a>
            <a href="pages/menu.html"><i class="fa-solid fa-bars"></i>Menu</a>
            <a href="pages/about.html"><i class="fa-regular  fa-user"></i>About</a>
            <a href="pages/gallery.html"><i class="fa-solid fa-images"></i>Gallery</a>
            <a href="pages/contact.html"><i class="fa-solid fa-envelope"></i>Contact</a>
        </nav>

    </header>


    <!-- Main -->
    <main>

        <!-- Hero Section -->
        <section class="hero">

            <div class="hero-content">

                <h1>Savor the Perfect Brew!</h1>

                <p>
                    Enjoy delicious coffee and sweet moments
                    in a warm and relaxing atmosphere.
                </p>

                <a href="pages/menu.html" class="btn">
                    View Menu
                </a>

                <a href="pages/contact.html" class="btn second-btn">
                    Contact Us
                </a>

            </div>

        </section>


        <!-- Specialties -->
        <section class="specialties">

            <h2>Our Specialties</h2>

            <div class="specialty-container">

                <article>
                    <div class="coffee-icon">☕</div>
                    <h3>Espresso</h3>
                    <p>Rich and strong coffee.</p>
                </article>

                <article>
                    <div class="coffee-icon">☕</div>
                    <h3>Latte</h3>
                    <p>Soft and creamy coffee.</p>
                </article>

                <article>
                    <div class="coffee-icon">☕</div>
                    <h3>Cappuccino</h3>
                    <p>Perfect coffee with foam.</p>
                </article>

                <article>
                    <div class="coffee-icon">☕</div>
                    <h3>Cold Brew</h3>
                    <p>Fresh and refreshing.</p>
                </article>


                <article>
                    <div class="coffee-icon">🍰</div>
                    <h3>Chocolate Cake</h3>
                    <p>Rich  Chocolate.</p>
                </article>

                <article>
                    <div class="coffee-icon">🍰</div>
                    <h3>Cheesecake</h3>
                    <p>Soft and creamy Cake.</p>
                </article>

                <article>
                    <div class="coffee-icon">🍰</div>
                    <h3>Cookies</h3>
                    <p>Perfect cookies with chocolate.</p>
                </article>

                <article>
                    <div class="coffee-icon">🍰</div>
                    <h3>Brownie</h3>
                    <p>Fresh brownie.</p>
                </article>

            </div>

        </section>


        <!-- Why Choose Us -->
        <section class="why-us">

            <div class="why-text">

                <h2>Why Choose Us?</h2>

                <p>
                    We carefully prepare every cup using
                    high-quality coffee beans and fresh ingredients.
                </p>

                <a href="pages/about.html" class="btn">
                    Learn More
                </a>

            </div>

            <div class="why-image">
                <img src="images/coffee1.jpg" alt="Coffee">
            </div>

        </section>


        <!-- Offer -->
        <section class="offer">

            <h2>Special Offer</h2>

            <h3>20% OFF</h3>

            <p>
                Enjoy our special coffee offer every morning.
            </p>

            <a href="pages/menu.html" class="btn">
                Order Now
            </a>

        </section>


        <!-- Gallery Preview -->
        <section class="gallery-preview">

            <h2>Visit Us Today</h2>

            <p>
                Discover our delicious coffee and desserts and cozy atmosphere.
            </p>

            <div class="gallery-container">

                <img src="images/coffee1.jpg" alt="Coffee">
                <img src="images/coffee2.jpg" alt="Coffee">
                <img src="images/coffee3.jpg" alt="Coffee">
                <img src="images/coffee4.jpg" alt="Coffee">
                <img src="images/brownie.jpg" alt="desserts">
                <img src="images/cake.jpg" alt="desserts">
                <img src="images/cheesecake.jpg" alt="desserts">
                <img src="images/cookies.jpg" alt="desserts">

            </div>

        </section>

    </main>


    <!-- Footer -->
    <footer>

        <h2>Violetta Café ☕</h2>

        <p>
            Fresh coffee. Sweet moments.
        </p>

        <p>
            © 2026 Violetta Café. All Rights Reserved.
        </p>

    </footer>
    <script src="js/bootstrap.bundle.min.js"></script>

</body>

</html>